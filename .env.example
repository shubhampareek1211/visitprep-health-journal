# PostgreSQL 16+ connection. Use a dedicated, least-privilege database.
DATABASE_URL=postgres://visitprep:replace-me@localhost:5432/visitprep_dev

# Used by the integration test suite only. Never point this at production.
TEST_DATABASE_URL=postgres://visitprep:replace-me@localhost:5432/visitprep_test

# Long random value; Vercel sends this as the cleanup cron Bearer token.
CRON_SECRET=replace-with-a-long-random-secret
